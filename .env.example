BACKEND_PORT=4000
FRONTEND_PORT=3000
# Local frontend server -> backend. Compose sets http://backend:4000.
INTERNAL_API_URL=http://localhost:4000
# Required PostgreSQL server connection string. In Compose, use a host reachable from the container.
DATABASE_URL=postgresql://growly:password@localhost:5432/growly
# Separate test database; tests create and drop temporary schemas.
TEST_DATABASE_URL=postgresql://growly:password@localhost:5432/growly_test
